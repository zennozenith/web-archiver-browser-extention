{
  "manifest_version": 3,
  "name": "URL Archiver",
  "version": "0.0.1",
  "description": "Archive pages (HTML, screenshot, headers, metadata) to your own archive server.",
  "minimum_chrome_version": "110",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "URL Archiver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "archive-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Archive the current page"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
