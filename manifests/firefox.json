{
  "manifest_version": 3,
  "name": "URL Archiver",
  "version": "0.0.1",
  "description": "Archive pages (HTML, screenshot, headers, metadata) to your own archive server.",
  "browser_specific_settings": {
    "gecko": {
      "id": "url-archiver@archive.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["browsingActivity", "websiteContent"] }
    }
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["common.js", "background.js"] },
  "action": {
    "default_title": "URL Archiver",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "archive-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Archive the current page"
    }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
