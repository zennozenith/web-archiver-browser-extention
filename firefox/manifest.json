{
  "manifest_version": 2,
  "name": "URL Archiver Client",
  "version": "1.0.0",
  "description": "Capture the current page (HTML, URL, headers, metadata) and send it to your own archive server.",
  "browser_specific_settings": {
    "gecko": { "id": "url-archiver@example.local", "strict_min_version": "91.0" }
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "permissions": ["activeTab", "tabs", "storage", "webRequest", "<all_urls>"],
  "optional_permissions": ["cookies"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Archive this page"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Archive this page"
    }
  }
}
