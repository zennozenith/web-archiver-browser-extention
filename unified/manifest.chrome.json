{
  "manifest_version": 3,
  "name": "URL Archiver Client",
  "version": "4.0.0",
  "description": "Archive pages to your own server and work through a pending-URL list from a toolbar popup.",
  "minimum_chrome_version": "121",
  "permissions": ["activeTab", "tabs", "storage", "webRequest", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "optional_permissions": ["cookies"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "URL Archiver",
    "default_popup": "popup.html"
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "commands": {
    "archive-page": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Archive the current page"
    }
  }
}
