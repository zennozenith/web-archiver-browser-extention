{
  "name": "cross-browser-extension-starter",
  "displayName": "Cross-Browser Extension Starter",
  "version": "1.0.0",
  "description": "A modern Chrome and Firefox Manifest V3 extension starter built with Bun, TypeScript, and Vite.",
  "type": "module",
  "scripts": {
    "dev": "TARGET=chrome vite",
    "dev:chrome": "TARGET=chrome vite",
    "dev:firefox": "TARGET=firefox vite",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "tsc --noEmit && TARGET=chrome vite build",
    "build:firefox": "tsc --noEmit && TARGET=firefox vite build",
    "typecheck": "tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "preview": "vite preview"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/webextension-polyfill": "^0.12.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "web-ext": "^10.8.0"
  }
}