{
  "name": "myopic-web-extention",
  "displayName": "Web Archiver",
  "version": "0.0.2",
  "private": true,
  "description": "Archive pages (HTML, screenshot, headers, metadata) to your own archive server.",
  "type": "module",
  "scripts": {
    "dev": "TARGET=chrome vp dev",
    "dev:chrome": "TARGET=chrome vp dev",
    "dev:firefox": "TARGET=firefox vp dev",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "tsc --noEmit && TARGET=chrome vp build",
    "build:firefox": "tsc --noEmit && TARGET=firefox vp build",
    "typecheck": "tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "preview": "vp preview",
    "prepare": "vp config"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/webextension-polyfill": "^0.12.6",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "web-ext": "^10.8.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  }
}
